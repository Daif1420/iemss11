{
  "name": "iems",
  "version": "2.0.0",
  "private": true,
  "description": "IEMS Employee Management System",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npm --prefix frontend run build && node backend/server.js",
    "start": "node backend/server.js",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "postinstall": "node -e \"if(!require('fs').existsSync('frontend/node_modules'))require('child_process').execSync('npm --prefix frontend install --no-audit --no-fund',{stdio:'inherit'})\""
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.75.0",
    "pg": "^8.16.3",
    "recharts": "^3.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "vite-plugin-pwa": "^2.0.0"
  }
}
