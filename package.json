{
  "name": "iems",
  "version": "2.0.0",
  "private": true,
  "description": "IEMS Employee Management System",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npm --prefix frontend run build && node backend/server.js",
    "start": "node backend/server.js",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "postinstall": "npm --prefix frontend install --no-audit --no-fund"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3"
  }
}